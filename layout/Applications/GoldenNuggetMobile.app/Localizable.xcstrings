          "stringUnit": {
            "state": "translated",
            "value": "AirLift（AirTraffic）"
          }
        }
      }
    },
    "AirLift needs a pairing record and none is stored. Import one on the home page.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AirLift 需要配对记录，但目前尚未保存。请在首页导入。"
