      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该值不在 0…32 范围内。LocalDevVPN 的隧道 IP 使用 CIDR 格式，此值是斜杠后的前缀长度。"
          }
        }
      }
    },
    "Not a port in 1…65535 — %u is being probed instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口不在 1…65535 范围内，将改为探测 %u。"
