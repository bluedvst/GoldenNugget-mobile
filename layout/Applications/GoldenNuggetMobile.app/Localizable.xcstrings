{
  "sourceLanguage": "en",
  "strings": {
    "%@  •  %@  •  %@  •  iOS %@  •  %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@  •  %2$@  •  %3$@  •  iOS %4$@  •  %5$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  •  %@  •  %@  •  iOS %@  •  %@"
          }
        }
      }
    },
    "%@ (%lld/%lld)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$lld/%3$lld)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%lld/%lld）"
          }
        }
      }
    },
    "%@ (%llu KB)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$llu KB)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%llu KB）"
          }
        }
      }
    },
    "%@ has nothing in it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 中没有内容。"
          }
        }
      }
    },
    "%@ on the device, removed with no trash and no undo.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备上的 %@ 将直接删除，不经过回收站，也无法撤销。"
          }
        }
      }
    },
    "%@ uses the legacy %@ format.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ uses the legacy %2$@ format."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 使用旧版 %@ 格式。"
          }
        }
      }
    },
    "%@ will be copied into this app's container. Files larger than 64 MiB will also stay on the device. Free space there: %@. Once removed, the copy in the container is the only one -- and the container is deleted if the app is.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ will be copied into this app's container. Files larger than 64 MiB will also stay on the device. Free space there: %2$@. Once removed, the copy in the container is the only one -- and the container is deleted if the app is."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将复制到本应用的存储空间。超过 64 MiB 的文件也会保留在设备上。可用空间：%@。原文件删除后，仅剩应用内的副本；卸载应用也会删除副本。"
          }
        }
      }
    },
    "%@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        }
      }
    },
    "%@ — %lld file(s), %lld key(s) found.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ — %2$lld file(s), %3$lld key(s) found."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 找到 %lld 个文件、%lld 个键值。"
          }
        }
      }
    },
    "%lld file(s), %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld file(s), %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个文件，%@"
          }
        }
      }
    },
    "%lld files": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个文件"
          }
        }
      }
    },
    "%lld of %lld applicable tweak(s) enabled. Incompatible and un-ported tweaks are hidden, the same way the reference hides them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld applicable tweak(s) enabled. Incompatible and un-ported tweaks are hidden, the same way the reference hides them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用 %lld/%lld 项适用的修改。不兼容或尚未移植的修改会自动隐藏。"
          }
        }
      }
    },
    "%lld of %lld daemon group(s) on. The groups upstream marks interface-visible but gives no switch are in the Recommended set only.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld daemon group(s) on. The groups upstream marks interface-visible but gives no switch are in the Recommended set only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已开启 %lld/%lld 个守护进程分组。上游仅展示但未提供开关的分组只会出现在“推荐”分类。"
          }
        }
      }
    },
    "%lld operations found": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找到 %lld 项操作"
          }
        }
      }
    },
    "%lld override(s) → %@, written on the next Apply.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld override(s) → %2$@, written on the next Apply."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 项覆盖设置 → %@，下次点击“应用”时写入。"
          }
        }
      }
    },
    "%lld photo(s) and video(s) — %@ kept in the app": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld photo(s) and video(s) — %2$@ kept in the app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 张照片及视频 — %@ 已保存在应用内"
          }
        }
      }
    },
    "(empty = clear)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（留空表示清除）"
          }
        }
      }
    },
    ", %lld symlink(s) skipped": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "，跳过 %lld 个符号链接"
          }
        }
      }
    },
    "1 file": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 个文件"
          }
        }
      }
    },
    "1 · Tunnel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 · 隧道"
          }
        }
      }
    },
    "1. SysSharedContainerDomain-systemgroup.com.apple.configurationprofiles/Library/ConfigurationProfiles/CloudConfigurationDetails.plist, %lld setup panes marked skipped;": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 修改 CloudConfigurationDetails.plist，将 %lld 个设置页面标记为跳过；"
          }
        }
      }
    },
    "2 · Pairing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2 · 配对"
          }
        }
      }
    },
    "2. ManagedPreferencesDomain/mobile/com.apple.purplebuddy.plist, setup marked done.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 修改 com.apple.purplebuddy.plist，将初始设置标记为已完成。"
          }
        }
      }
    },
    "A folder. Nothing goes through a trash here — this is the device's own delete.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一个文件夹。删除操作直接作用于设备，不经过回收站。"
          }
        }
      }
    },
    "A video that carries a rotation transform is decoded in its stored orientation, which is what the reference's decoder does; such a clip may appear rotated on the Lock Screen.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带旋转信息的视频将按其原始存储方向解码，可能导致锁屏画面旋转。"
          }
        }
      }
    },
    "A wallpaper exists in two places at once — its descriptor files, and three rows in the store's own sqlite. The rows carry the device's provider registrations and the metadata the picker sorts by, so they cannot be invented: the apply fetches the store from the device first and adds rows to a copy of it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一张壁纸同时存在于描述文件和数据库中的三条记录中。记录包含设备的提供方注册信息与排序元数据，不能凭空生成。应用时会先读取设备数据库，再在其副本中添加记录。"
          }
        }
      }
    },
    "AAR handling": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AAR 处理"
          }
        }
      }
    },
    "AFC media": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AFC 媒体"
          }
        }
      }
    },
