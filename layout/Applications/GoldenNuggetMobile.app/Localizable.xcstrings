      }
    },
    "Update required": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须更新"
          }
        }
      }
    },
    "Updates": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新"
          }
        }
      }
    },
    "Upload": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传"
          }
        }
      }
    },
    "Uploads are capped at %@ — an AFC write is a single call with no streaming form, so a larger file is refused rather than truncated.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传文件大小上限为 %@。AFC 写入采用单次调用，不支持流式传输，因此超大文件会直接拒绝，而不会截断。"
          }
        }
      }
    },
    "Upstream caps a selection at %lld descriptors, so an import past the cap is refused rather than silently dropped. Each pack is copied into this app — removing it on the PosterBoard page removes the copy, not the original file.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上游将每次选择限制为最多 %lld 个描述文件，超过上限的导入会直接拒绝。每个壁纸包都会复制到本应用中，在 PosterBoard 页面移除时只会删除副本，不会删除原文件。"
          }
        }
      }
    },
    "Upstream caps a selection at %lld descriptors. Each pack is copied into this app, so removing one here removes the copy — the file you imported is untouched.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上游最多允许选择 %lld 个描述文件。每个壁纸包都会复制到本应用中，因此在此移除只删除副本，导入的原始文件不受影响。"
          }
        }
      }
    },
    "VPN": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN"
          }
        }
      }
    },
